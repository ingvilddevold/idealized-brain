<?xml version="1.0"?>
<!DOCTYPE Xdmf SYSTEM "Xdmf.dtd" []>
<Xdmf Version="3.0" xmlns:xi="https://www.w3.org/2001/XInclude">
  <Domain>
    <Grid Name="mesh" GridType="Uniform">
      <Topology TopologyType="Tetrahedron" NumberOfElements="17463" NodesPerElement="4">
        <DataItem Dimensions="17463 4" NumberType="Int" Format="HDF">idealized.h5:/Mesh/mesh/topology</DataItem>
      </Topology>
      <Geometry GeometryType="XYZ">
        <DataItem Dimensions="3520 3" Format="HDF">idealized.h5:/Mesh/mesh/geometry</DataItem>
      </Geometry>
    </Grid>
    <Grid Name="subdomains" GridType="Uniform">
      <xi:include xpointer="xpointer(/Xdmf/Domain/Grid/Geometry)" />
      <Topology TopologyType="Tetrahedron" NumberOfElements="17463" NodesPerElement="4">
        <DataItem Dimensions="17463 4" NumberType="Int" Format="HDF">idealized.h5:/MeshTags/subdomains/topology</DataItem>
      </Topology>
      <Attribute Name="subdomains" AttributeType="Scalar" Center="Cell">
        <DataItem Dimensions="17463 1" Format="HDF">idealized.h5:/MeshTags/subdomains/Values</DataItem>
      </Attribute>
    </Grid>
    <Grid Name="subdomains_ftetwild" GridType="Uniform">
      <xi:include xpointer="xpointer(/Xdmf/Domain/Grid/Geometry)" />
      <Topology TopologyType="Tetrahedron" NumberOfElements="17463" NodesPerElement="4">
        <DataItem Dimensions="17463 4" NumberType="Int" Format="HDF">idealized.h5:/MeshTags/subdomains_ftetwild/topology</DataItem>
      </Topology>
      <Attribute Name="subdomains_ftetwild" AttributeType="Scalar" Center="Cell">
        <DataItem Dimensions="17463 1" Format="HDF">idealized.h5:/MeshTags/subdomains_ftetwild/Values</DataItem>
      </Attribute>
    </Grid>
    <Grid Name="boundaries" GridType="Uniform">
      <xi:include xpointer="xpointer(/Xdmf/Domain/Grid/Geometry)" />
      <Topology TopologyType="Triangle" NumberOfElements="4324" NodesPerElement="3">
        <DataItem Dimensions="4324 3" NumberType="Int" Format="HDF">idealized.h5:/MeshTags/boundaries/topology</DataItem>
      </Topology>
      <Attribute Name="boundaries" AttributeType="Scalar" Center="Cell">
        <DataItem Dimensions="4324 1" Format="HDF">idealized.h5:/MeshTags/boundaries/Values</DataItem>
      </Attribute>
    </Grid>
    <Grid Name="boundaries_split" GridType="Uniform">
      <xi:include xpointer="xpointer(/Xdmf/Domain/Grid/Geometry)" />
      <Topology TopologyType="Triangle" NumberOfElements="4332" NodesPerElement="3">
        <DataItem Dimensions="4332 3" NumberType="Int" Format="HDF">idealized.h5:/MeshTags/boundaries_split/topology</DataItem>
      </Topology>
      <Attribute Name="boundaries_split" AttributeType="Scalar" Center="Cell">
        <DataItem Dimensions="4332 1" Format="HDF">idealized.h5:/MeshTags/boundaries_split/Values</DataItem>
      </Attribute>
    </Grid>
  </Domain>
</Xdmf>
